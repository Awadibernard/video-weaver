# Environment variables required by Tikmation (pipeline complet)
# Copy to `.env` locally, or configure as GitHub Actions secrets.

# --- Étape 1 : génération du quiz (Groq / Llama-3) ---
GROQ_API_KEY=

# --- Étape 2 : voix off — pipeline TTS à 3 niveaux ---
# NIVEAU 1 : ElevenLabs (liste possible, rotation sur 401/402/429)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# NIVEAU 2 : Fish Audio — jusqu'à 8 clés séparées par des virgules
FISH_AUDIO_API_KEYS=
# FISH_AUDIO_REFERENCE_ID=
# FISH_AUDIO_MODEL_ID=speech-1.6
# NIVEAU 3 : Edge TTS (gratuit, binaire `edge-tts` requis)
# EDGE_TTS_VOICE=fr-BE-GerardNeural


# --- Étape 3 : publication TikTok via Buffer ---
BUFFER_ACCESS_TOKEN=
BUFFER_TIKTOK_PROFILE_ID=

# --- Bot Telegram (long polling, dossier bot/) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
GITHUB_PAT=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# --- Optionnel : force le nombre de questions (sinon tirage pondéré 5..10) ---
# QUESTION_COUNT=
